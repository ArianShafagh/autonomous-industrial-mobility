<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robofetch_ai</name>
  <version>0.1.0</version>
  <description>Decision models (rule-based, neuro-symbolic, RL) and the fast factory simulator used to train and evaluate them.</description>
  <maintainer email="shafagh.arian2003@gmail.com">robojazzy</maintainer>
  <license>MIT</license>
  <exec_depend>robofetch_core</exec_depend>
  <exec_depend>robofetch_factory</exec_depend>

  <exec_depend>python3-pytest</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
